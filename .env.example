# Flask Application Configuration
SECRET_KEY=tifinify-dev-secret-key-replace-in-production-2026
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///tifinify.db

# External AI & Location APIs
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Application Discovery Settings
DEMO_MODE=True
MAX_SEARCH_RADIUS_KM=15.0
CACHE_ANALYSIS_DAYS=7
